{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "typeRoots": ["../node_modules/@figma", "../node_modules/@types"],
    "types": ["plugin-typings"],
    "skipLibCheck": true
  },
  "include": ["src"]
}
