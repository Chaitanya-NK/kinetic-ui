{
  "name": "@kineticui/core",
  "version": "0.4.0",
  "description": "Kinetic UI core: design tokens, theme provider, cn() and hooks.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "^19.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chaitanya-NK/kinetic-ui.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://kinetic-ui.chaitanya-nk.com",
  "bugs": "https://github.com/Chaitanya-NK/kinetic-ui/issues"
}
