{
  "name": "@kineticui/ui",
  "version": "0.1.1",
  "description": "Kinetic UI components — motion-first, accessible React components for Next.js and Tailwind CSS v4.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "import": "./dist/form.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kineticui/core": "^0.1.1",
    "@kineticui/icons": "^0.1.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "motion": "^12.23.0",
    "radix-ui": "^1.4.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": "^7.55.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7"
  },
  "keywords": [
    "react",
    "nextjs",
    "tailwindcss",
    "components",
    "ui",
    "motion",
    "shadcn",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chaitanya-NK/kinetic-ui.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://kinetic-ui.chaitanya-nk.com",
  "bugs": "https://github.com/Chaitanya-NK/kinetic-ui/issues",
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  }
}
