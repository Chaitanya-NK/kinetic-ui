  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chaitanya-NK/kinetic-ui.git",
    "directory": "packages/motion"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://kinetic-ui.chaitanya-nk.com",
